{
  "name": "@elleffe-tech/whatsapp",
  "version": "2.0.0",
  "type": "module",
  "description": "TypeScript SDK for interfacing with the WhatsApp Business Platform Cloud API from Node.js.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elleffe-Tech/WhatsApp-TS-SDK-Tech.git"
  },
  "homepage": "https://github.com/Elleffe-Tech/WhatsApp-TS-SDK-Tech",
  "bugs": {
    "url": "https://github.com/Elleffe-Tech/WhatsApp-TS-SDK-Tech/issues"
  },
  "author": "Elleffe Tech",
  "contributors": [],
  "license": "MIT",
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "WhatsApp",
    "SDK",
    "Business",
    "Platform",
    "secure",
    "messaging",
    "Node.js",
    "Cloud API"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "fix": "pnpm run /^fix:.*/",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "lint": "pnpm run /^lint:.*/",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:publint": "publint",
    "lint:typecheck": "npm run typecheck",
    "release": "pnpm run build && changeset publish",
    "test": "pnpm build && pnpm test:coverage && pnpm test:package",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=80 --test-coverage-functions=95 --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.type-test.ts' --test-coverage-exclude='src/test/**' --test ./src/**/*.test.ts ./src/*.test.ts",
    "test:package": "node --test ./tests/node/*.test.mjs",
    "test:unit": "node --import tsx --test ./src/**/*.test.ts ./src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ky": "^2.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-pkg": "^0.22.1",
    "publint": "^0.3.18",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "overrides": {
    "flatted": "3.4.2",
    "glob": "10.5.0",
    "picomatch": "4.0.4",
    "tmp": "0.2.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "overrides": {
      "tmp": "0.2.5",
      "glob": "10.5.0",
      "picomatch": "4.0.4",
      "flatted": "3.4.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
